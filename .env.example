# ==============================================================================
# Rafithub Environment Variables
# Copy to .env.local for local development. Never commit secrets.
# ==============================================================================

# --- Public Site ---
NEXT_PUBLIC_SITE_URL=https://www.rafithub.com

# --- Database (Neon PostgreSQL) ---
# Pooled connection string (used at runtime)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection string (used by Prisma migrations; pulled by `neon env pull`)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Neon Auth (Managed Better Auth) ---
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=replace-with-32-byte-random-secret

# --- Neon Object Storage (S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
NEON_ASSETS_BUCKET=assets
NEON_UPLOADS_BUCKET=uploads

# --- Neon Realtime ---
NEON_REALTIME_URL=
NEXT_PUBLIC_NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# --- Initial Owner Seed (change password on first login) ---
OWNER_EMAIL=owner@rafithub.com
OWNER_INITIAL_PASSWORD=replace-with-strong-initial-password

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Rafithub <noreply@rafithub.com>
CONTACT_EMAIL=rafithubmdu@gmail.com

# --- Media Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# --- Rate Limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# --- Scheduled Jobs (Vercel Cron) ---
CRON_SECRET=replace-with-random-cron-secret

# --- Monitoring (Sentry) ---
SENTRY_DSN=
